# ---------------------------------------------------------------------------
# HERMES Odoo - production environment
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit or share `.env`. It contains secrets.
# ---------------------------------------------------------------------------

# Public hostname served by Caddy. Point an A/AAAA record at this server.
DOMAIN=htms.example.com

# Email used for the Let's Encrypt (ACME) account and expiry notices.
ACME_EMAIL=admin@example.com

# --- Database -------------------------------------------------------------
DB_NAME=htms
DB_USER=odoo
DB_PASSWORD=change-me-strong-db-password

# --- Odoo -----------------------------------------------------------------
# Odoo master password (database manager). Keep secret.
ODOO_ADMIN_PASSWD=change-me-strong-master-password

# Initial admin login/password. The password is applied only on the very
# first initialization; later changes in the UI are preserved.
HERMES_ADMIN_LOGIN=admin
HERMES_ADMIN_PASSWORD=change-me-strong-admin-password

# Canonical public URL. Must match DOMAIN and be reachable over HTTPS.
ODOO_BASE_URL=https://htms.example.com

# Worker processes. Rule of thumb: (2 x CPU cores) + 1. Use 0 for small hosts.
ODOO_WORKERS=4
ODOO_MAX_CRON_THREADS=2
ODOO_LOG_LEVEL=info

# --- PayMongo -------------------------------------------------------------
# Sandbox keys start with sk_test_, production keys with sk_live_.
# Leave blank to configure later in the Odoo UI.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# One of: test | enabled | disabled
PAYMONGO_STATE=test

# --- Locale ---------------------------------------------------------------
TZ=Asia/Manila
