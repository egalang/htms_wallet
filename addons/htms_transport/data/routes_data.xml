<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ======================= PRODUCT CATEGORIES ======================= -->
        <record id="product_category_htms" model="product.category">
            <field name="name">HERMES Transport</field>
        </record>
        <record id="product_category_htms_fares" model="product.category">
            <field name="name">Bus Fares</field>
            <field name="parent_id" ref="product_category_htms"/>
